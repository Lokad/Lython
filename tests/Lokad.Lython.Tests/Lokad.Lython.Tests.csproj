<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>Lokad.Lython.WhiteBox.Tests</AssemblyName>
    <!-- Production sources compile into this assembly, including the unsafe
         stack-pointer read in ExecutionGuards.StackRuler. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lokad.Parsing" />
    <PackageReference Include="Lokad.Utf8Regex.PythonRe" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    White-box subsystem tests compile the production sources into the test
    assembly. This keeps implementation details internal without granting a
    friend assembly or widening the package's public API.
  -->
  <ItemGroup>
    <Compile
      Include="..\..\src\Lokad.Lython\**\*.cs"
      Exclude="..\..\src\Lokad.Lython\bin\**;..\..\src\Lokad.Lython\obj\**"
      LinkBase="Production" />
    <EmbeddedResource Include="..\..\src\Lokad.Lython\Runtime\Text\Data\html5.json" LogicalName="Lokad.Lython.html5.json" />
  </ItemGroup>
</Project>
