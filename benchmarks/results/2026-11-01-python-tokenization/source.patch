diff --git a/tests/Lokad.Lython.PublicApi.Tests/PythonTokenizationExecutionTests.cs b/tests/Lokad.Lython.PublicApi.Tests/PythonTokenizationExecutionTests.cs
new file mode 100644
index 00000000..9e1ffe47
--- /dev/null
