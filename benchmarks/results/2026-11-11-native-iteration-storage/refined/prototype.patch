+using Lokad.Lython.Frontend;
+using Lokad.Lython.Runtime.Text;
+
+namespace Lokad.Lython.Runtime;
+
+internal sealed partial class LythonRuntime
+{
+    // Only an immediate compiler-owned iteration consumer may receive a cased
+    // source in place of its Python list. Ordinary results remain ordinary values.
+    // Keep this handoff inline through calls, returns and protected cleanup.
+    internal struct ExecutableResult(object? value)
+    {
+        internal object? Value = value;
+        internal ExecutionContext? IterationContext;
+        internal ExecutableCasedSplit? CasedSplit;
+    }
+
+    private struct NativeIterationState
+    {
+        internal ExecutionContext? Context;
+        internal ExecutableCasedSplit? CasedSplit;
+        // Lists and tuples use Position; cased words use the shared scanner.
+        internal PyStringOps.WhitespaceRangeState Range;
+    }
+
+    internal partial struct ExecutableValueStorage
+    {
+        private void EnsureNativeIterationStorage(LythonSourceSpan span)
+        {
+            if (_nativeIterations is not null) return;
+            // Includes reference fields, scanner scalars and deliberate headroom.
+            // One retained backing replaces both position storage and word carriers.
+            var count = _items.Length - _firstTemporarySlot;
+            var bytes = checked(32L + 48L * count);
+            using var storage = _state.MemoryGovernor.ReserveTemporary(bytes, span);
+            _state.CheckExecution(span);
+            if (_nativeIterations is not null) return;
+            var ownedBytes = checked(_ownedStorageBytes + bytes);
+            var states = new NativeIterationState[count];
+            storage.Commit(bytes);
+            _nativeIterations = states;
+            _ownedStorageBytes = ownedBytes;
+        }
+
+        private void ClearNativeIteration(int slot)
+        {
+            if (_nativeIterations is not null && slot >= _firstTemporarySlot)
+                _nativeIterations[slot - _firstTemporarySlot] = default;
+        }
+
+        internal readonly ExecutableResult ReadResult(int slot, object? value = null)
+        {
+            var result = new ExecutableResult(value);
+            if (_nativeIterations is not null && slot >= _firstTemporarySlot)
+            {
+                ref readonly var state = ref _nativeIterations[slot - _firstTemporarySlot];
+                result.IterationContext = state.Context;
+                result.CasedSplit = state.CasedSplit;
+            }
+            return result;
+        }
+
+        internal void PublishIterationResult(int slot, int liveExtent, in ExecutableResult result)
+        {
+            var recipe = result.CasedSplit!;
+            EnsureNativeIterationStorage(recipe.SplitCallSpan);
+            PublishValue(slot, liveExtent, result.Value.RequireNotNull());
+            _nativeIterations![slot - _firstTemporarySlot] = new NativeIterationState
+            {
+                Context = result.IterationContext,
+                CasedSplit = recipe,
+                Range = PyStringOps.CreateCasedWhitespaceState(recipe.Upper),
+            };
+        }
+    }
+}
