+    private static void FillKeywordOnlyDefaults(Span<object> values, ArgumentPresence assigned,
+        FunctionBindingPlan plan, ExecutionContext context, LythonSourceSpan span)
+    {
+        for (var k = 0; k < plan.KeywordOnlyCount; k++)
+        {
+            var i = plan.PositionalCount + k;
+            if (assigned[i]) continue;
+            var defaults = plan.KeywordDefaultStorage;
+            if (defaults is null || !defaults.TryGetValue(plan.KeywordDefaultNames[k], out var value, context, span))
+                throw CallErrors.MissingArgument(plan.CallableKind, plan.CallableName, plan.NameAt(i), span);
+            values[i] = value;
+        }
+    }
