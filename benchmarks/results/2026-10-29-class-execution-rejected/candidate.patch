diff --git a/tests/Lokad.Lython.PublicApi.Tests/ClassExecutionTests.cs b/tests/Lokad.Lython.PublicApi.Tests/ClassExecutionTests.cs
new file mode 100644
index 00000000..fbf29552
--- /dev/null
+++ b/tests/Lokad.Lython.PublicApi.Tests/ClassExecutionTests.cs
@@ -0,0 +1,33 @@
+using System.Text.Json;
+using Lokad.Lython.Tests.Harness;
+
+namespace Lokad.Lython.PublicApi.Tests;
+
+public sealed class ClassExecutionTests
+{
+    // Independent CPython 3.13.2 expectations, including class-created generators.
+    public static IEnumerable<object[]> Cases()
+    {
+        var path = Path.Combine(AppContext.BaseDirectory, "Fixtures", "ClassExecution", "cases.json");
+        foreach (var row in JsonSerializer.Deserialize<JsonElement[]>(File.ReadAllText(path))!)
+            yield return [row.GetProperty("name").GetString()!, row.GetProperty("source").GetString()!, row.GetProperty("output").GetString()!];
+    }
+
+    [Theory, MemberData(nameof(Cases))]
+    public async Task ClassSuitesPreservePythonNamespacesAndGeneratorProtocols(string name, string source, string expected)
+    {
+        var budget = new LythonMemoryBudget(4 * 1024 * 1024);
+        using var script = new LythonEngine().Compile(source, budget);
+        Assert.True(script.IsValid, name + ": " + string.Join("; ", script.Diagnostics.Select(d => d.Message)));
+        var baseline = budget.ReservedBytes;
+        foreach (var asynchronous in new[] { false, true })
+        {
+            using (var result = asynchronous ? await script.RunAsync(new MockLythonHost()) : script.Run(new MockLythonHost()))
+            {
+                Assert.True(result.Success, name + ": " + result.Failure?.Message);
+                Assert.Equal(expected, result.StandardOutput);
+            }
+            Assert.Equal(baseline, budget.ReservedBytes);
+        }
+    }
+}
