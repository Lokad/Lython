diff --git a/tests/Lokad.Lython.Tests/StringJoinCleanupTests.cs b/tests/Lokad.Lython.Tests/StringJoinCleanupTests.cs
new file mode 100644
index 00000000..4d3936d9
--- /dev/null
+++ b/tests/Lokad.Lython.Tests/StringJoinCleanupTests.cs
@@ -0,0 +1,97 @@
+using System.Numerics;
+using Lokad.Lython.Frontend;
+using Lokad.Lython.Runtime;
+using Lokad.Lython.Runtime.Text;
+using Lokad.Lython.Tests.Harness;
+using Context = Lokad.Lython.Runtime.LythonRuntime.ExecutionContext;
+
+namespace Lokad.Lython.Tests;
+
+public sealed class StringJoinCleanupTests
+{
+    private static readonly LythonSourceSpan Span = new(2, 3, 4, 5);
+
+    [Theory]
+    [InlineData(false, false)]
+    [InlineData(true, false)]
+    [InlineData(false, true)]
+    [InlineData(true, true)]
+    public async Task ResultAdmissionIncludesLiveDrainAndBuilder(bool asynchronous, bool shared)
+    {
+        const long limit = 1024 * 1024;
+        var budget = new LythonMemoryBudget(limit);
+        using (var owner = budget.CreateScope())
+        {
+            var context = new Context(new MockLythonHost(), new LythonRunOptions
+                { MemoryBudget = owner, MaxExecutionMemoryBytes = shared ? null : limit });
+            var governor = context.MemoryGovernor;
+            var first = PyString.FromString("abcd", governor, Span);
+            var last = PyString.FromString("efgh", governor, Span);
+            var parts = new PyList([first, last], governor, Span);
+            var code = ExecutableScript.Compile(LoweredScript.Lower(LythonFrontend.Compile("return '|'.join").Script!)).EntryPoint;
+            var callable = Assert.IsAssignableFrom<LythonRuntime.ICallable>(LythonRuntime.ExecuteExecutableCodeObject(code, context, default, null));
+            // Four drained slots (64), builder capacity (16), nine output bytes
+            // plus metadata (137). Leave one byte too little for the final value.
+            var available = 64 + 16 + PyString.EstimateApproximateBytes(9) - 1;
+            ILythonMemoryReservation? blocker = null;
+            if (shared) Assert.True(budget.TryReserve(limit - budget.ReservedBytes - available, out blocker));
+            else
+            {
+                var padding = limit - governor.CurrentCommittedBytes - available;
+                governor.Reserve(padding, Span);
+                governor.Commit(padding);
+            }
+            using (blocker)
+            {
+                var before = governor.CurrentCommittedBytes;
+                object? published = null;
+                CallArgumentValue[] arguments = [CallArgumentValue.Positional(parts)];
+                var error = await Assert.ThrowsAsync<LythonRuntimeException>(async () =>
+                {
+                    published = asynchronous ? await callable.InvokeAsync(arguments, Span, context)
+                        : callable.Invoke(arguments, Span, context);
+                });
+                Assert.Null(published);
+                Assert.Equal(shared ? LythonFailureReason.SharedMemoryAllowance : LythonFailureReason.ExecutionMemoryLimit, error.Attribution?.Reason);
+                Assert.Same(governor.AdmissionFailure, error);
+                Assert.Same(Span, error.Span);
+                Assert.Equal(PyString.EstimateApproximateBytes(9), governor.LastDeniedReservationBytes);
+                Assert.Equal(before, governor.CurrentCommittedBytes);
+                Assert.Equal(0, governor.CurrentReservedBytes);
+                Assert.Same(first, parts[0]);
+                Assert.Same(last, parts[1]);
+            }
+        }
+        Assert.Equal(0, budget.ReservedBytes);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task InvalidItemReleasesDrainedAndOutputScratch(bool asynchronous)
+    {
+        var budget = new LythonMemoryBudget(1024 * 1024);
+        using (var owner = budget.CreateScope())
+        {
+            var context = new Context(new MockLythonHost(), new LythonRunOptions { MemoryBudget = owner });
+            var first = PyString.FromString("abcdefghij", context.MemoryGovernor, Span);
+            var parts = new PyList([first, BigInteger.One], context.MemoryGovernor, Span);
+            var code = ExecutableScript.Compile(LoweredScript.Lower(LythonFrontend.Compile("return '|'.join").Script!)).EntryPoint;
+            var callable = Assert.IsAssignableFrom<LythonRuntime.ICallable>(LythonRuntime.ExecuteExecutableCodeObject(code, context, default, null));
+            var before = context.MemoryGovernor.CurrentCommittedBytes;
+            CallArgumentValue[] arguments = [CallArgumentValue.Positional(parts)];
+            var error = await Assert.ThrowsAsync<LythonRuntimeException>(async () =>
+            {
+                if (asynchronous) await callable.InvokeAsync(arguments, Span, context);
+                else callable.Invoke(arguments, Span, context);
+            });
+            Assert.Equal("TypeError", error.ExceptionType);
+            Assert.Equal(before, context.MemoryGovernor.CurrentCommittedBytes);
+            Assert.Equal(0, context.MemoryGovernor.CurrentReservedBytes);
+            Assert.Null(context.MemoryGovernor.AdmissionFailure);
+            Assert.Same(first, parts[0]);
+            Assert.Equal(BigInteger.One, parts[1]);
+        }
+        Assert.Equal(0, budget.ReservedBytes);
+    }
+}
diff --git a/tests/Lokad.Lython.PublicApi.Tests/StringJoinIterationTests.cs b/tests/Lokad.Lython.PublicApi.Tests/StringJoinIterationTests.cs
new file mode 100644
index 00000000..a676fcd4
--- /dev/null
+++ b/tests/Lokad.Lython.PublicApi.Tests/StringJoinIterationTests.cs
@@ -0,0 +1,105 @@
+using Lokad.Lython.Tests.Harness;
+
+namespace Lokad.Lython.PublicApi.Tests;
+
+public sealed class StringJoinIterationTests
+{
+    public static IEnumerable<object[]> Cases()
+    {
+        foreach (var asynchronous in new[] { false, true })
+        {
+            foreach (var form in new[] { "direct", "exposed", "expanded" })
+            {
+                var call = form switch { "exposed" => "method(parts())", "expanded" => "'|'.join(*[parts()])", _ => "'|'.join(parts())" };
+                foreach (var failLate in new[] { false, true })
+                {
+                    var source = "events=[]\ndef parts():\n events.append('first')\n yield 1\n events.append('second')\n "
+                        + (failLate ? "raise ValueError('later iteration failure')" : "yield 'valid'")
+                        + "\nmethod='|'.join\ntry:\n " + call + "\nexcept Exception as error:\n print(type(error).__name__,str(error))\nprint(events)";
+                    var expected = (failLate ? "ValueError later iteration failure" : "TypeError sequence item 0: expected str instance, int found")
+                        + "\n['first', 'second']\n";
+                    yield return [asynchronous, form + (failLate ? "-late-error" : "-drain"), source, expected];
+                }
+            }
+            yield return [asynchronous, "values", "print('|'.join([]),'|'.join(['one']),'|'.join(('café','😀')),'-'.join('ab'))", " one café|😀 a-b\n"];
+            yield return [asynchronous, "custom-iterator", "events=[]\nclass Parts:\n def __iter__(self):\n  events.append('iter')\n  yield 1\n  events.append('after')\n  raise ValueError('custom')\ntry:'|'.join(Parts())\nexcept Exception as error:print(type(error).__name__,str(error))\nprint(events)", "ValueError custom\n['iter', 'after']\n"];
+        }
+    }
+
+    [Theory]
+    [MemberData(nameof(Cases))]
+    public async Task MatchesPythonDrainAndErrorOrder(bool asynchronous, string name, string source, string expected)
+    {
+        using var script = new LythonEngine().Compile(source);
+        Assert.True(script.IsValid, name + ": " + string.Join("; ", script.Diagnostics.Select(d => d.Message)));
+        using var result = asynchronous ? await script.RunAsync(new MockLythonHost()) : script.Run(new MockLythonHost());
+        Assert.True(result.Success, result.Failure?.Message);
+        Assert.Equal(expected, result.StandardOutput);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task DrainAwaitsHostIoBeforeValidationAndCleanup(bool cancel)
+    {
+        var budget = new LythonMemoryBudget(2 * 1024 * 1024);
+        using var script = new LythonEngine().Compile("def parts():\n yield 1\n with open('audit.txt','a') as output:output.write('seen')\n yield 'valid'\nreturn '|'.join(parts())", budget);
+        Assert.True(script.IsValid);
+        var baseline = budget.ReservedBytes;
+        var host = new DelayedLythonHost();
+        host.SeedFile("/audit.txt", "before");
+        var entered = cancel ? host.PauseWriteUntilCancellation("/audit.txt") : null;
+        using var cancellation = new CancellationTokenSource();
+        var pending = script.RunAsync(host, cancellationToken: cancellation.Token);
+        try
+        {
+            if (entered is not null)
+            {
+                await entered.WaitAsync(TimeSpan.FromSeconds(10));
+                Assert.False(pending.IsCompleted);
+                Assert.True(budget.ReservedBytes > baseline);
+                cancellation.Cancel();
+            }
+            using var result = await pending.WaitAsync(TimeSpan.FromSeconds(10));
+            Assert.False(result.Success);
+            if (cancel) Assert.Equal(LythonFailureReason.Cancelled, result.FailureAttribution?.Reason);
+            else Assert.Equal("TypeError", result.Failure?.ExceptionType);
+            Assert.Equal(cancel ? "before" : "beforeseen", host.ReadText("/audit.txt"));
+            Assert.True(host.CompletedAsynchronously > 0);
+        }
+        finally
+        {
+            cancellation.Cancel();
+            using var drained = await pending.WaitAsync(TimeSpan.FromSeconds(10));
+        }
+        Assert.Equal(baseline, budget.ReservedBytes);
+        script.Dispose();
+        Assert.Equal(0, budget.ReservedBytes);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task RetainedResultKeepsSharedFundingAcrossExecutions(bool asynchronous)
+    {
+        var budget = new LythonMemoryBudget(2 * 1024 * 1024);
+        using (var script = new LythonEngine().Compile("return '|'.join(['café','😀'])", budget))
+        {
+            Assert.True(script.IsValid);
+            var baseline = budget.ReservedBytes;
+            using (var retained = asynchronous ? await script.RunAsync(new MockLythonHost()) : script.Run(new MockLythonHost()))
+            {
+                Assert.True(retained.Success, retained.Failure?.Message);
+                Assert.Equal("café|😀", retained.ReturnValue);
+                var held = budget.ReservedBytes;
+                Assert.True(held > baseline);
+                using (var next = asynchronous ? await script.RunAsync(new MockLythonHost()) : script.Run(new MockLythonHost()))
+                    Assert.True(next.Success, next.Failure?.Message);
+                Assert.Equal(held, budget.ReservedBytes);
+                Assert.Equal("café|😀", retained.ReturnValue);
+            }
+            Assert.Equal(baseline, budget.ReservedBytes);
+        }
+        Assert.Equal(0, budget.ReservedBytes);
+    }
+}
