  "rejectedChange": "Delete only MemoryGovernor.ReclaimForExhaustion GC.Collect; not integrated",
  "originalDiagnosticSource": "using System.Diagnostics;\nusing System.Numerics;\nusing System.Text.Json;\nusing Lokad.Lython.Tests.Harness;\n\nnamespace Lokad.Lython.Tests;\n\npublic sealed class ForcedGcDependencyDiagnosticTests\n{\n    [Theory]\n    [InlineData(false, false)]\n    [InlineData(false, true)]\n    [InlineData(true, false)]\n    [InlineData(true, true)]\n    public async Task Scan(bool asynchronous, bool retained)\n    {\n        var source = \"import csv\\nr=csv.reader('a,b,c,d,e,f\\\\n' for i in range(4000))\\n\" +\n            (retained ? \"rows=list(r)\\nreturn len(rows)\\n\" : \"total=0\\nfor row in r:\\n total+=1\\nreturn total\\n\");\n        var script = new LythonEngine().Compile(source);\n        Assert.True(script.IsValid);\n        var options = new LythonRunOptions { MaxExecutionMemoryBytes = 262144 };\n        var before = new[] { GC.CollectionCount(0), GC.CollectionCount(1), GC.CollectionCount(2) };\n        var watch = Stopwatch.StartNew();\n        var result = asynchronous ? await script.RunAsync(new MockLythonHost(), options) : script.Run(new MockLythonHost(), options);\n        watch.Stop();\n        var receipt = new\n        {\n            asynchronous, retained, rows = 4000, cap = 262144,\n            result.Success, exceptionType = result.Failure?.ExceptionType,\n            result.PeakExecutionMemoryBytes,\n            collections = Enumerable.Range(0, 3).Select(i => GC.CollectionCount(i) - before[i]).ToArray(),\n            elapsedMilliseconds = watch.ElapsedMilliseconds\n        };\n        var directory = Environment.GetEnvironmentVariable(\"LYTHON_GC_DIAG_DIR\")!;\n        Assert.False(string.IsNullOrEmpty(directory));\n        Directory.CreateDirectory(directory);\n        File.WriteAllText(Path.Combine(directory, $\"scan-{asynchronous}-{retained}.json\"), JsonSerializer.Serialize(receipt));\n        if (retained)\n        {\n            Assert.False(result.Success);\n            Assert.Equal(\"MemoryError\", result.Failure?.ExceptionType);\n        }\n        else\n        {\n            Assert.True(result.Success, result.Failure?.Message);\n            Assert.Equal(new BigInteger(4000), result.ReturnValue);\n        }\n    }\n}"
}