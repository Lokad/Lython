+namespace Lokad.Lython.Frontend;
+
+internal sealed record ExecutableEnterComprehension(int ScopeSlot, ScopeDirectiveFacts Facts) : ExecutableOperation;
+internal sealed record ExecutableGetComprehensionIterator : ExecutableOperation;
+internal sealed record ExecutableAdvanceComprehension(int IteratorSlot) : ExecutableOperation;
+internal sealed record ExecutableAppendComprehension(int ListSlot) : ExecutableOperation;
+internal sealed record ExecutableLeaveComprehension(int IteratorSlot, int ScopeSlot = -1) : ExecutableOperation;
+
+internal sealed partial class ExecutableScript
+{
+    private sealed partial class Builder
+    {
+        private readonly Stack<IReadOnlySet<string>> _comprehensionBindings = [];
+
+        private bool IsComprehensionBinding(string name)
+            => _comprehensionBindings.Any(bindings => bindings.Contains(name));
+
+        private int CompileListComprehension(LoweredListComprehensionExpression expression, int block)
+        {
+            var scopeSlot = InternSyntheticLocal("comprehension_scope");
+            var listSlot = InternSyntheticLocal("comprehension_list");
+            var iteratorSlot = InternSyntheticLocal("comprehension_iterator");
+            // The outer iterable and its __iter__ run before the lexical bindings.
+            block = CompileExpression(expression.Clauses[0].Iterable, block);
+            EmitOperation(new ExecutableGetComprehensionIterator(), expression.Clauses[0].Iterable.Span, block);
+            AddInstruction(block, ExecutableInstruction.StoreLocal(iteratorSlot, expression.Span));
+            var start = CreateBlock();
+            AddInstruction(block, ExecutableInstruction.Jump(start, expression.Span));
+            AddInstruction(start, ExecutableInstruction.MakeList(0, expression.Span));
+            AddInstruction(start, ExecutableInstruction.StoreLocal(listSlot, expression.Span));
+            EmitOperation(new ExecutableEnterComprehension(scopeSlot, expression.ScopeFacts), expression.Span, start);
+            _comprehensionBindings.Push(expression.ScopeFacts.LocalNames);
+            int exit;
+            try { exit = CompileComprehensionClause(expression, 0, iteratorSlot, listSlot, start); }
+            finally { _comprehensionBindings.Pop(); }
+            var after = FinishComprehensionRegion(start, exit, iteratorSlot, scopeSlot, expression.Span);
+            AddInstruction(after, ExecutableInstruction.LoadLocal(listSlot, expression.Span));
+            ClearSlot(listSlot, after);
+            return after;
+        }
+
+        private int CompileComprehensionClause(LoweredListComprehensionExpression expression,
+            int index, int iteratorSlot, int listSlot, int block)
+        {
+            var clause = expression.Clauses[index];
+            var head = CreateBlock();
+            var stop = CreateBlock();
+            var body = CreateBlock();
+            AddInstruction(block, ExecutableInstruction.Jump(head, clause.Span));
+            EmitOperation(new ExecutableAdvanceComprehension(iteratorSlot), clause.Span, head);
+            AddInstruction(head, ExecutableInstruction.JumpIfFalse(stop, clause.Span));
+            if (clause.Target is LoopNameTargetSyntax name)
+                CompileStoreBoundName(name.Name, clause.Span, head);
+            else
+                AddInstruction(head, ExecutableInstruction.AssignLoopTarget(InternLoopTarget(clause.Target, clause.Span), clause.Span));
+            AddInstruction(head, ExecutableInstruction.Jump(body, clause.Span));
+            if (clause.Condition is { } condition)
+            {
+                body = CompileExpression(condition, body);
+                AddInstruction(body, ExecutableInstruction.JumpIfFalse(head, condition.Span));
+            }
+            if (index + 1 == expression.Clauses.Count)
+            {
+                body = CompileExpression(expression.ItemExpression, body);
+                EmitOperation(new ExecutableAppendComprehension(listSlot), expression.Span, body);
+            }
+            else
+            {
+                var inner = expression.Clauses[index + 1];
+                var innerSlot = InternSyntheticLocal("comprehension_iterator");
+                body = CompileExpression(inner.Iterable, body);
+                EmitOperation(new ExecutableGetComprehensionIterator(), inner.Iterable.Span, body);
+                AddInstruction(body, ExecutableInstruction.StoreLocal(innerSlot, inner.Span));
+                var start = CreateBlock();
+                AddInstruction(body, ExecutableInstruction.Jump(start, inner.Span));
+                var exit = CompileComprehensionClause(expression, index + 1, innerSlot, listSlot, start);
+                body = FinishComprehensionRegion(start, exit, innerSlot, -1, inner.Span);
+            }
+            AddInstruction(body, ExecutableInstruction.Jump(head, clause.Span));
+            AddInstruction(stop, ExecutableInstruction.PopTop(clause.Span)); // Exhaustion placeholder.
+            return stop;
+        }
+
+        private int FinishComprehensionRegion(int start, int exit, int iteratorSlot, int scopeSlot, LythonSourceSpan span)
+        {
+            var end = _blocks.Count - 1;
+            var cleanup = CreateBlock();
+            var after = CreateBlock();
+            _regions.Add(new ExecutableExceptionRegion(start, end, null, null, null,
+                cleanup, start, end, CleanupId: cleanup));
+            AddInstruction(exit, ExecutableInstruction.Jump(cleanup, span));
+            EmitOperation(new ExecutableLeaveComprehension(iteratorSlot, scopeSlot), span, cleanup);
+            AddInstruction(cleanup, ExecutableInstruction.EndFinally(after, span, cleanup));
+            return after;
+        }
+
+        private void ClearSlot(int slot, int block)
+        {
+            AddInstruction(block, ExecutableInstruction.LoadConst(InternConstant(Runtime.PyNone.Instance), EmptySpan));
+            AddInstruction(block, ExecutableInstruction.StoreLocal(slot, EmptySpan));
+        }
+    }
+}
