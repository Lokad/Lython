+    internal static void PrepareFunctionCallBinding(CallExpressionSyntax call, FunctionParameterLayout layout,
+        int firstParameter, StaticAnalysisContext? context)
+    {
+        if (call.PreparedParameterLayout is not null || layout.VariadicListIndex >= 0 || layout.VariadicDictionaryIndex >= 0
+            || firstParameter > layout.PositionalCount
+            || !call.TryGetConcreteArguments(out var arguments)) return;
+        // Fully supplied positional calls already borrow operands directly.
+        if (layout.KeywordOnlyCount == 0 && call.Arguments.Count == layout.ParameterCount - firstParameter
+            && arguments.Keywords.Count == 0) return;
+        // This retained map can grow with signature width, independently of
+        // source length. Admit its full metadata/capacity before allocating it.
+        var bytes = checked(64L + 4L * layout.ParameterCount);
+        using var storage = context?.MemoryGovernor?.ReserveTemporary(bytes, call.Span);
+        context?.MemoryGovernor?.ThrowIfAdmissionFailed();
+        PythonTokenization.CheckCancellation(context?.CancellationToken ?? default, 0);
+        var sources = new int[layout.ParameterCount];
+        Array.Fill(sources, -1); // An omitted value is resolved from live defaults.
+        if (firstParameter != 0) sources[0] = -2; // Existing bound receiver.
+        var positional = firstParameter;
+        for (var index = 0; index < call.Arguments.Count; index++)
+        {
+            PythonTokenization.CheckCancellation(context?.CancellationToken ?? default, index);
+            var argument = call.Arguments[index];
+            var slot = argument.Kind == CallArgumentKind.Positional ? positional++
+                : layout.LayoutParameterIndex.GetValueOrDefault(argument.KeywordName, -1);
+            // Validation normally excluded these shapes. Inference can visit
+            // expanded/merged states too: an unproved map is simply not retained.
+            if ((uint)slot >= (uint)sources.Length || sources[slot] != -1) return;
+            sources[slot] = index;
+        }
+        storage?.Commit(bytes);
+        call.PreparedParameterLayout = layout;
+        call.PreparedParameterSources = sources;
+    }
