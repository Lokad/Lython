<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Lokad.Lython"><HintPath>$(CoreDirectory)/Lokad.Lython.dll</HintPath></Reference>
    <Reference Include="Lokad.Parsing"><HintPath>$(CoreDirectory)/Lokad.Parsing.dll</HintPath></Reference>
    <Compile Include="Program.cs" />
    <Compile Include="../../../tests/Lokad.Lython.Tests/Harness/MockLythonHost.cs" Link="MockLythonHost.cs" />
  </ItemGroup>
  <Target Name="RequireImmutableCore" BeforeTargets="ResolveReferences" Condition="'$(CoreDirectory)' == ''">
    <Error Text="Supply -p:CoreDirectory with an immutable Release core and Lokad.Parsing DLL directory." />
  </Target>
</Project>
