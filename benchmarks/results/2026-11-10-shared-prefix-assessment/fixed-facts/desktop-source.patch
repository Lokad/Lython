+            internal object this[int index]
+            {
+                readonly get => _values[index].RequireNotNull();
+                set => _values[index] = value;
+            }
+
+            internal readonly ReadOnlySpan<object?> Slice(int start, int count) => _values.Slice(start, count);
+            internal readonly void CheckExecution(LythonSourceSpan span) => _owner.CheckExecution(span);
+            internal readonly ExecutableLookupCache[] GetLookupCaches(int count, LythonSourceSpan span)
+            {
+                if (!SupportsLookupCaching)
+                    throw new InvalidOperationException("Lookup storage requires persistent frame backing.");
+                return _owner.GetLookupCaches(count, span);
+            }
+
+            internal void PublishValue(int resultSlot, int liveExtent, object value)
+            {
+                if (liveExtent < LiveExtent) RetireTo(liveExtent);
+                _values[resultSlot] = value;
+                _owner.LiveExtent = liveExtent;
+            }
+
+            internal object TakeValue(int inputSlot, int liveExtent)
+            {
+                var value = _values[inputSlot].RequireNotNull();
+                _values[inputSlot] = null!;
+                _owner.LiveExtent = liveExtent;
+                return value;
+            }
+
+            internal void ForgetResultInput(int resultSlot)
+            {
+                _values[resultSlot] = null!;
+                _owner.LiveExtent = resultSlot;
+            }
+
+            internal void RetireTo(int liveExtent)
+            {
+                if (liveExtent == LiveExtent) return;
+                for (var i = Math.Min(LiveExtent - 1, _owner._lastOwnedTemporarySlot); i >= liveExtent; i--)
+                {
+                    if (_owner.DeferAsyncDisposal && _values[i] is PyIteration.Cursor cursor)
+                    {
+                        if (_owner._pendingDisposalTail is null) _owner._pendingDisposalHead = cursor;
+                        else _owner._pendingDisposalTail.NextPendingDisposal = cursor;
+                        _owner._pendingDisposalTail = cursor;
+                        _values[i] = null!;
+                    }
+                    else if (_values[i] is ExecutableTemporaryValue temporary) temporary.Dispose();
+                }
+                _values.Slice(liveExtent, LiveExtent - liveExtent).Clear();
+                _owner.LiveExtent = liveExtent;
+            }
+
+            internal readonly bool TryPrepareNativeIteration(object source, int slot, int liveExtent, LythonSourceSpan span)
+                => _owner.TryPrepareNativeIteration(source, slot, liveExtent, span);
+            internal readonly bool TryAdvanceNativeIteration(int slot, out PyIterationResult next)
+                => _owner.TryAdvanceNativeIteration(slot, out next);
+        }
+    }
+}
