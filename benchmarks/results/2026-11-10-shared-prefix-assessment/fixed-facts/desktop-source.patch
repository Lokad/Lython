diff --git a/src/Lokad.Lython/Frontend/ExecutableScript.ClosedPrefix.cs b/src/Lokad.Lython/Frontend/ExecutableScript.ClosedPrefix.cs
new file mode 100644
index 00000000..d2dab8a5
--- /dev/null
+++ b/src/Lokad.Lython/Frontend/ExecutableScript.ClosedPrefix.cs
@@ -0,0 +1,101 @@
+using Lokad.Lython.Runtime;
+
+namespace Lokad.Lython.Frontend;
+
+internal sealed partial class ExecutableCodeObject
+{
+    private static (LythonRuntime.ReceiverMethod? Method, LythonRuntime.NativeReturnShape Shape) PrepareClosedStringMethod(string name)
+    {
+        var method = LythonRuntime.StringMembers.GetMethod(name);
+        var shape = LythonRuntime.NativeReturnShape.Other;
+        if (method is not null && method.AcceptsPositional(0)
+            && StaticContracts.TryGetMemberReturnShape(AbstractValueKind.String, name, out var result))
+            shape = result switch
+            {
+                StaticReturnShape.String => LythonRuntime.NativeReturnShape.String,
+                StaticReturnShape.Bytes => LythonRuntime.NativeReturnShape.Bytes,
+                StaticReturnShape.Boolean => LythonRuntime.NativeReturnShape.Boolean,
+                StaticReturnShape.ListOfString => LythonRuntime.NativeReturnShape.Sized,
+                _ => LythonRuntime.NativeReturnShape.Other,
+            };
+        return (method, shape);
+    }
+
+    // Reuse the finished instruction stream. There is no second expression
+    // representation or native argument-source domain to construct or retain.
+    private bool PrepareClosedPrefix(out bool hasBranches)
+    {
+        hasBranches = false;
+        if (!IsFunctionScope || RequiresLocalVariableMirroring || CapturedLocalSlots.Count != 0
+            || ClosureNames.Count != 0 || ExceptionRegions.Count != 0 || ValueStorageCapacity > ClosedOperandCapacity)
+            return false;
+        var visited = new bool[Instructions.Length];
+        var branches = false;
+        var eligible = Visit(EntryIndex, false, 0);
+        hasBranches = branches;
+        return eligible;
+
+        bool Visit(int position, bool hasEffects, int depth)
+        {
+            // An optimization bound, preserving the existing managed proof depth.
+            // Wider/control-heavy functions continue through ordinary execution.
+            if (depth > 16) return false;
+            while ((uint)position < (uint)Instructions.Length)
+            {
+                if (visited[position]) return false; // cycles or shared joins
+                visited[position] = true;
+                var instruction = Instructions[position];
+                switch (instruction.OpCode)
+                {
+                    case ExecutableOpCode.Jump:
+                        position = instruction.TargetIndex;
+                        continue;
+                    case ExecutableOpCode.CompareJumpIfFalse:
+                        if (!LythonRuntime.TryGetNativeBinaryShape(instruction.BinaryOperator,
+                            LythonRuntime.NativeReturnShape.Integer,
+                            LythonRuntime.NativeReturnShape.Integer, out _)) return false;
+                        hasEffects = true;
+                        goto case ExecutableOpCode.JumpIfFalse;
+                    case ExecutableOpCode.JumpIfFalse:
+                        branches = true;
+                        return Visit(position + 1, hasEffects, depth + 1)
+                            && Visit(instruction.TargetIndex, hasEffects, depth + 1);
+                    case ExecutableOpCode.Return or ExecutableOpCode.ReturnNone:
+                        return true;
+                    case ExecutableOpCode.LoadLocal or ExecutableOpCode.LoadConst or ExecutableOpCode.StoreLocal
+                        or ExecutableOpCode.LoadCallMember:
+                        break;
+                    case ExecutableOpCode.LoadGlobal or ExecutableOpCode.Subscript:
+                        // Admission can change a later mutable lookup. A proof
+                        // cannot authorize that lookup before earlier work runs.
+                        if (hasEffects) return false;
+                        break;
+                    case ExecutableOpCode.Call:
+                        var call = CallSites[instruction.CallSiteIndex];
+                        if (!call.IsPositionalOnly || call.ArgumentCount > 3) return false;
+                        hasEffects = true;
+                        break;
+                    case ExecutableOpCode.Binary:
+                        if (!LythonRuntime.TryGetNativeBinaryShape(instruction.BinaryOperator,
+                            LythonRuntime.NativeReturnShape.Integer,
+                            LythonRuntime.NativeReturnShape.Integer, out _)) return false;
+                        hasEffects = true;
+                        break;
+                    case ExecutableOpCode.MakeList or ExecutableOpCode.MakeTuple
+                        or ExecutableOpCode.ConvertFormattedValue:
+                        hasEffects = true;
+                        break;
+                    case ExecutableOpCode.FormatField:
+                        if (Constants[instruction.ConstantIndex] is not ExecutableFormatField { DynamicSpecifier: false, Append: false })
+                            return false;
+                        hasEffects = true;
+                        break;
+                    default:
+                        return false;
+                }
+                position++;
+            }
+            return false;
+        }
+    }
+}
