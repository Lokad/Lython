+
+internal sealed partial class LythonRuntime
+{
+    // An ephemeral view never owns storage and cannot survive suspension. The
+    // persistent state remains the sole owner of caches, capacity and cleanup.
+    internal ref struct ExecutableWorkView
+    {
+        private readonly ref ExecutableWorkState _state;
+        internal ExecutableValueStorage.Window Stack;
+
+        internal ExecutableWorkView(ref ExecutableWorkState state, Span<object> values)
+        {
+            _state = ref state;
+            Code = state.Code;
+            Stack = new(ref state.Stack, values);
+        }
+
+        internal readonly ExecutableCodeObject Code;
+        internal readonly Span<object> Locals => Stack.Values;
+        internal readonly ExecutableCell?[]? LocalCells => _state.LocalCells;
+        internal readonly IReadOnlyList<ExecutableCell>? ClosureCells => _state.ClosureCells;
+        internal ref int InstructionIndex => ref _state.InstructionIndex;
+        internal object? ReturnValue { readonly get => _state.ReturnValue; set => _state.ReturnValue = value; }
+    }
+
+    internal sealed partial class ExecutionContext
+    {
+        private static object ReadOperand(ref ExecutableWorkState state, int source, ExecutionContext scope, int input)
+        {
+            var view = new ExecutableWorkView(ref state, state.Stack.Values);
+            return ReadOperand(ref view, source, scope, input);
+        }
+        private static object TakeOperand(ref ExecutableWorkState state, in ExecutableInstruction instruction, ExecutionContext scope)
+        {
+            var view = new ExecutableWorkView(ref state, state.Stack.Values);
+            return TakeOperand(ref view, instruction, scope);
+        }
+        private static bool CompleteComparisonBranch(ref ExecutableWorkState state, ExecutionContext context, in ExecutableInstruction instruction, bool truth)
+        {
+            var view = new ExecutableWorkView(ref state, state.Stack.Values);
+            return CompleteComparisonBranch(ref view, context, instruction, truth);
+        }
+        private static void ExecuteStackTransfer(ref ExecutableWorkState state, ExecutionContext scope, ExecutionContext? invocation, in ExecutableInstruction instruction)
+        {
+            var view = new ExecutableWorkView(ref state, state.Stack.Values);
+            ExecuteStackTransfer(ref view, scope, invocation, instruction);
+        }
+        private static void ExecuteSliceValueOperation(ref ExecutableWorkState state, ExecutionContext scope, ExecutionContext? invocation, in ExecutableInstruction instruction)
+        {
+            var view = new ExecutableWorkView(ref state, state.Stack.Values);
+            ExecuteSliceValueOperation(ref view, scope, invocation, instruction);
+        }
+    }
