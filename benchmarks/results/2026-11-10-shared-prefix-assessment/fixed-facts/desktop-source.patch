+    private static bool TrySelectClosedStringCall(object target, ReadOnlySpan<object?> arguments, out ReceiverMethod method)
+    {
+        method = target as ReceiverMethod ?? null!;
+        return method is not null && TryGetClosedStringCallShape(method, arguments.Length,
+            arguments.Length > 0 ? ReturnShape(arguments[0]) : NativeReturnShape.None,
+            arguments.Length > 1 ? ReturnShape(arguments[1]) : NativeReturnShape.None,
+            arguments.Length > 2 ? ReturnShape(arguments[2]) : NativeReturnShape.None, out _);
+    }
+
+    private static object InvokeClosedStringCall(ReceiverMethod method, PyString receiver,
+        ReadOnlySpan<object?> arguments, LythonSourceSpan span, ExecutionContext context)
+    {
+        try
+        {
+            if (ReferenceEquals(method, ReceiverMethods.StringSplit))
+                return InvokeStringSplit(receiver, arguments[0], arguments.Length > 1 ? arguments[1] : null, span, context);
+            if (ReferenceEquals(method, ReceiverMethods.StringReplace))
+                return InvokeStringReplace(receiver, arguments[0]!, arguments[1]!, arguments.Length > 2 ? arguments[2] : null, span, context);
+            return InvokeStringAffix(receiver, arguments[0]!, span, context, ReferenceEquals(method, ReceiverMethods.StringStartsWith));
