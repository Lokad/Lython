new file mode 100644
index 00000000..61dbfad2
--- /dev/null
+++ b/src/Lokad.Lython/Runtime/LythonRuntime.Executable.ClosedPrefix.cs
@@ -0,0 +1,112 @@
+using System.Numerics;
+using Lokad.Lython.Frontend;
+using Lokad.Lython.Runtime.Text;
+
+namespace Lokad.Lython.Runtime;
+
+internal sealed partial class LythonRuntime
+{
+    internal static bool TryExecuteNativeReturn(ExecutableCodeObject codeObject, ExecutionContext context,
+        ReadOnlySpan<object?> arguments, LythonSourceSpan entrySpan, out object result)
+    {
+        result = PyNone.Instance;
+        if (!codeObject.SupportsClosedPrefix || context.MirrorLocalStores || context.CurrentExecutableFrame is not null
+            || context.ActiveHandlerVariables is { Count: > 0 }) return false;
+        if (!GuardClosedPrefix(codeObject, arguments, context)) return false;
+        result = ExecuteClosedPrefix(codeObject, context, arguments, entrySpan);
+        return true;
+    }
+
+    internal static bool TryExecuteNativeFunction(ExecutableCodeObject code, ExecutionContext context,
+        ReadOnlySpan<object?> arguments, string name, LythonSourceSpan span, out object result)
+    {
+        result = PyNone.Instance;
+        if (!code.SupportsClosedPrefix || !GuardClosedPrefix(code, arguments, context)) return false;
+        context.EnterFunctionCall(span);
+        try { result = ExecuteClosedPrefix(code, context, arguments, span); return true; }
+        catch (LythonRuntimeException error)
+        {
+            PyFunctionBinding.AnnotateException(error, context, name, span);
+            throw;
+        }
+        finally { context.LeaveFunctionCall(); }
+    }
+
+    [System.Runtime.CompilerServices.InlineArray(ExecutableCodeObject.ClosedOperandCapacity)]
+    private struct ClosedOperandBuffer { private object _first; }
+
+    private static object ExecuteClosedPrefix(ExecutableCodeObject code,
+        ExecutionContext context, ReadOnlySpan<object?> arguments, LythonSourceSpan entrySpan)
+    {
+        context.EnterInterpreterFrame(entrySpan);
+        try
+        {
+            ClosedOperandBuffer buffer = default;
+            Span<object> values = buffer;
+            values = values[..code.ValueStorageCapacity];
+            values[..code.FirstTemporarySlot].Fill(UninitializedLocal);
+            for (var i = 0; i < arguments.Length; i++) values[i] = RuntimeValue(arguments[i]);
+            var work = new ExecutableWorkState { Code = code, Stack = new(code, context), InstructionIndex = code.EntryIndex };
+            var view = new ExecutableWorkView(ref work, values);
+            var entryException = context.State.CurrentException;
+            try
+            {
+                ExecutionContext.ExecuteClosedInstructionPrefix(ref view, context);
+                return work.ReturnValue ?? PyNone.Instance;
+            }
+            finally
+            {
+                try { view.Stack.RetireTo(0); }
+                finally { values.Clear(); context.State.SetCurrentException(entryException); }
+            }
+        }
+        finally { context.LeaveInterpreterFrame(); }
+    }
+
+    internal enum NativeReturnShape { Uninitialized, Other, None, Integer, Float, Boolean, String, Bytes, Dictionary, Sized }
+
+    private static NativeReturnShape ReturnShape(object? value) => value switch
+    {
+        null or PyNone => NativeReturnShape.None,
+        BigInteger => NativeReturnShape.Integer,
+        double => NativeReturnShape.Float,
+        bool => NativeReturnShape.Boolean,
+        PyString => NativeReturnShape.String,
+        PyBytes => NativeReturnShape.Bytes,
+        PyDict { HasProtocolKeys: false } => NativeReturnShape.Dictionary,
+        PyList or PyTuple or PyDict or PySet or PyRange or PyDeque => NativeReturnShape.Sized,
+        _ => NativeReturnShape.Other,
+    };
+
+    // One pure fact serves frontend eligibility and the runtime type proof.
+    // It authorizes canonical operations, never evaluates values or protocols.
+    internal static bool TryGetNativeBinaryShape(BinaryOperatorSyntax op, NativeReturnShape left,
+        NativeReturnShape right, out NativeReturnShape result)
+    {
+        result = NativeReturnShape.Other;
+        if (op == BinaryOperatorSyntax.Add && left == NativeReturnShape.String && right == left)
+        {
+            result = left;
+            return true;
+        }
+        if (left is not (NativeReturnShape.Integer or NativeReturnShape.Float or NativeReturnShape.Boolean)
+            || right is not (NativeReturnShape.Integer or NativeReturnShape.Float or NativeReturnShape.Boolean)) return false;
+        var integral = left != NativeReturnShape.Float && right != NativeReturnShape.Float;
+        result = op switch
+        {
+            BinaryOperatorSyntax.Add or BinaryOperatorSyntax.Subtract or BinaryOperatorSyntax.Multiply
+                or BinaryOperatorSyntax.FloorDivide or BinaryOperatorSyntax.Modulo
+                => integral ? NativeReturnShape.Integer : NativeReturnShape.Float,
+            BinaryOperatorSyntax.Divide => NativeReturnShape.Float,
+            BinaryOperatorSyntax.BitwiseOr or BinaryOperatorSyntax.BitwiseXor or BinaryOperatorSyntax.BitwiseAnd when integral
+                => left == NativeReturnShape.Boolean && right == left ? NativeReturnShape.Boolean : NativeReturnShape.Integer,
+            BinaryOperatorSyntax.LeftShift or BinaryOperatorSyntax.RightShift when integral => NativeReturnShape.Integer,
+            BinaryOperatorSyntax.Equal or BinaryOperatorSyntax.NotEqual or BinaryOperatorSyntax.Less
+                or BinaryOperatorSyntax.LessEqual or BinaryOperatorSyntax.Greater or BinaryOperatorSyntax.GreaterEqual
+                => NativeReturnShape.Boolean,
+            _ => NativeReturnShape.Other,
+        };
+        return result != NativeReturnShape.Other;
+    }
+
+}
diff --git a/src/Lokad.Lython/Runtime/LythonRuntime.Executable.ClosedProof.cs b/src/Lokad.Lython/Runtime/LythonRuntime.Executable.ClosedProof.cs
new file mode 100644
index 00000000..c962b412
--- /dev/null
+++ b/src/Lokad.Lython/Runtime/LythonRuntime.Executable.ClosedProof.cs
@@ -0,0 +1,185 @@
+using Lokad.Lython.Frontend;
+using Lokad.Lython.Runtime.Text;
+
+namespace Lokad.Lython.Runtime;
+
+internal sealed partial class LythonRuntime
+{
+    private struct ClosedProofValue
+    {
+        internal object? Actual;
+        internal PyString? SubscriptKey;
+        internal NativeReturnShape Shape, MethodResult;
+
+        internal ClosedProofValue(object value) { Actual = value; Shape = ReturnShape(value); }
+        internal ClosedProofValue(NativeReturnShape shape) { Shape = shape; }
+        internal readonly bool Valid => Shape != NativeReturnShape.Uninitialized;
+    }
+
+    [System.Runtime.CompilerServices.InlineArray(ExecutableCodeObject.ClosedOperandCapacity)]
+    private struct ClosedProofStorage { private ClosedProofValue _first; }
+
+    // This is a type proof over the finished IR, not another execution route.
+    // It performs no guest operation or admission. Both paths must be closed
+    // before the shared prefix begins; computed values retain shapes only.
+    private static bool GuardClosedPrefix(ExecutableCodeObject code, ReadOnlySpan<object?> arguments, ExecutionContext context)
+    {
+        ClosedProofStorage values = default;
+        for (var i = 0; i < arguments.Length; i++) values[i] = new(RuntimeValue(arguments[i]));
+        return GuardClosedPath(code, context, ref values, code.EntryIndex, 0);
+    }
+
+    private static ClosedProofValue ReadClosedProof(ExecutableCodeObject code, in ClosedProofStorage values, int source)
+        => source < 0 ? new(RuntimeValue(code.Constants[~source])) : values[source];
+
+    private static bool ResolveClosedProof(ExecutableCodeObject code, ref ClosedProofValue value,
+        ExecutionContext context, LythonSourceSpan span)
+    {
+        if (!value.Valid) return false;
+        if (value.SubscriptKey is not { } key) return true;
+        // Keep unselected storage queries out of a conditional proof. The
+        // actual prefix performs its selected lookup with the original span.
+        if (code.HasClosedPrefixBranches || !((PyDict)value.Actual!).TryReadNativeStringValue(key, context, span, out var actual))
+            return false;
+        value = new(actual);
+        return true;
+    }
+
+    private static bool GuardClosedPath(ExecutableCodeObject code, ExecutionContext context,
+        ref ClosedProofStorage values, int position, int depth)
+    {
+        if (depth > 16) return false;
+        var instructions = code.Instructions;
+        while ((uint)position < (uint)instructions.Length)
+        {
+            ref readonly var instruction = ref instructions[position];
+            context.CheckExecution(instruction.Span);
+            ClosedProofValue value;
+            switch (instruction.OpCode)
+            {
+                case ExecutableOpCode.ReturnNone:
+                    return true;
+                case ExecutableOpCode.Return:
+                    return ReadClosedProof(code, in values, instruction.InputStart).Valid;
+                case ExecutableOpCode.Jump:
+                    position = instruction.TargetIndex;
+                    continue;
+                case ExecutableOpCode.JumpIfFalse:
+                    var condition = ReadClosedProof(code, in values, instruction.InputStart);
+                    if (!condition.Valid || condition.Shape == NativeReturnShape.Other) return false;
+                    goto Branch;
+                case ExecutableOpCode.CompareJumpIfFalse:
+                    var left = ReadClosedProof(code, in values, instruction.InputStart);
+                    var right = ReadClosedProof(code, in values, instruction.SecondInput);
+                    if (!left.Valid || !right.Valid || !TryGetNativeBinaryShape(instruction.BinaryOperator, left.Shape, right.Shape, out _)) return false;
+                    goto Branch;
+                case ExecutableOpCode.LoadConst:
+                    value = new(RuntimeValue(code.Constants[instruction.ConstantIndex]));
+                    break;
+                case ExecutableOpCode.LoadLocal:
+                    value = values[instruction.LocalSlot];
+                    if (!value.Valid) return false;
+                    break;
+                case ExecutableOpCode.LoadGlobal:
+                    if (!TryResolveExecutableGlobal(code.Names[instruction.NameIndex], context, out var global)) return false;
+                    value = new(global);
+                    break;
+                case ExecutableOpCode.StoreLocal:
+                    value = ReadClosedProof(code, in values, instruction.InputStart);
+                    if (!value.Valid) return false;
+                    values[instruction.LocalSlot] = value;
+                    position++;
+                    continue;
+                case ExecutableOpCode.LoadCallMember:
+                    var receiver = ReadClosedProof(code, in values, instruction.InputStart);
+                    if (!ResolveClosedProof(code, ref receiver, context, instruction.Span) || receiver.Shape != NativeReturnShape.String) return false;
+                    var method = code.ClosedStringMethods[instruction.NameIndex];
+                    if (method.Method is null) return false;
+                    values[instruction.ResultSlot] = receiver;
+                    value = new(method.Method) { MethodResult = method.Shape };
+                    values[instruction.ResultSlot + 1] = value;
+                    position++;
+                    continue;
+                case ExecutableOpCode.Binary:
+                    var first = ReadClosedProof(code, in values, instruction.InputStart);
+                    var second = ReadClosedProof(code, in values, instruction.SecondInput);
+                    if (!first.Valid || !second.Valid || !TryGetNativeBinaryShape(instruction.BinaryOperator, first.Shape, second.Shape, out var binary)) return false;
+                    value = new(binary);
+                    break;
+                case ExecutableOpCode.Subscript:
+                    var target = ReadClosedProof(code, in values, instruction.InputStart);
+                    var key = ReadClosedProof(code, in values, instruction.SecondInput);
+                    if (target.Actual is not PyDict { HasProtocolKeys: false } dictionary || target.SubscriptKey is not null || key.Actual is not PyString text)
+                        return false;
+                    value = new(NativeReturnShape.Other) { Actual = dictionary, SubscriptKey = text };
+                    break;
+                case ExecutableOpCode.MakeList or ExecutableOpCode.MakeTuple:
+                    for (var i = 0; i < instruction.ItemCount; i++)
+                        if (!values[instruction.InputStart + i].Valid) return false;
+                    value = new(NativeReturnShape.Sized);
+                    break;
+                case ExecutableOpCode.ConvertFormattedValue or ExecutableOpCode.FormatField:
+                    var field = ReadClosedProof(code, in values, instruction.InputStart);
+                    if (!ResolveClosedProof(code, ref field, context, instruction.Span)
+                        || field.Shape is not (NativeReturnShape.None or NativeReturnShape.Integer or NativeReturnShape.Float
+                            or NativeReturnShape.Boolean or NativeReturnShape.String or NativeReturnShape.Bytes)) return false;
+                    value = new(NativeReturnShape.String);
+                    break;
+                case ExecutableOpCode.Call:
+                    var call = code.CallSites[instruction.CallSiteIndex];
+                    var start = instruction.InputStart;
+                    var callable = values[start + call.TargetOffset];
+                    if (call.HasReceiver)
+                    {
+                        if (values[start].Shape != NativeReturnShape.String || callable.Actual is not ReceiverMethod operation) return false;
+                        if (call.ArgumentCount == 0)
+                        {
+                            if (callable.MethodResult is NativeReturnShape.Uninitialized or NativeReturnShape.Other) return false;
+                            value = new(callable.MethodResult);
+                            break;
+                        }
+                        var a = values[start + call.ArgumentOffset];
+                        var b = call.ArgumentCount > 1 ? values[start + call.ArgumentOffset + 1] : new ClosedProofValue(NativeReturnShape.None);
+                        var c = call.ArgumentCount > 2 ? values[start + call.ArgumentOffset + 2] : new ClosedProofValue(NativeReturnShape.None);
+                        if (!a.Valid || !b.Valid || !c.Valid || !TryGetClosedStringCallShape(operation, call.ArgumentCount, a.Shape, b.Shape, c.Shape, out var methodShape)) return false;
+                        value = new(methodShape);
+                    }
+                    else
+                    {
+                        if (call.ArgumentCount != 1 || callable.Actual is not BuiltinCallable) return false;
+                        var argument = values[start + call.ArgumentOffset];
+                        if (!ResolveClosedProof(code, ref argument, context, call.CallSpan)
+                            || SelectNativeUnaryOperation(callable.Actual, argument.Actual, argument.Shape, out var unary) is null
+                            || unary == NativeReturnShape.Other) return false;
+                        value = new(unary);
+                    }
+                    break;
+                default:
+                    throw new InvalidOperationException("Unexpected instruction in a closed prefix proof.");
+            }
+            if (instruction.HasLocalResult)
+            {
+                var store = instructions[++position];
+                values[store.LocalSlot] = value;
+            }
+            else values[instruction.ResultSlot] = value;
+            position++;
+            continue;
+
+        Branch:
+            // Compilation excludes joins/cycles, so this visits each reachable
+            // instruction once. Only conditional paths copy the bounded slots.
+            return GuardClosedBranches(code, context, ref values, position, depth);
+        }
+        throw new InvalidOperationException("A closed prefix has no completion instruction.");
+    }
+    // Keep branch-only reference storage out of every straight-line proof frame.
+    private static bool GuardClosedBranches(ExecutableCodeObject code, ExecutionContext context,
+        ref ClosedProofStorage values, int position, int depth)
+    {
+        var alternative = values;
+        return GuardClosedPath(code, context, ref values, position + 1, depth + 1)
+            && GuardClosedPath(code, context, ref alternative, code.Instructions[position].TargetIndex, depth + 1);
+    }
+
+}
