+    internal static bool TryGetNativeUnaryShape(ExecutableUnaryOperator op, NativeReturnShape operand,
+        out NativeReturnShape result)
+    {
+        result = op switch
+        {
+            ExecutableUnaryOperator.Not when operand != NativeReturnShape.Other => NativeReturnShape.Boolean,
+            ExecutableUnaryOperator.Plus or ExecutableUnaryOperator.Minus
+                when operand is NativeReturnShape.Integer or NativeReturnShape.Boolean => NativeReturnShape.Integer,
+            ExecutableUnaryOperator.Plus or ExecutableUnaryOperator.Minus
+                when operand == NativeReturnShape.Float => NativeReturnShape.Float,
+            ExecutableUnaryOperator.BitwiseNot when operand is NativeReturnShape.Integer or NativeReturnShape.Boolean
+                => NativeReturnShape.Integer,
+            _ => NativeReturnShape.Other,
+        };
+        return result != NativeReturnShape.Other;
+    }
