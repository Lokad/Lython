index b29261f7..0e1c4527 100644
--- a/src/Lokad.Lython/Runtime/Text/PyStringOps.Whitespace.cs
+++ b/src/Lokad.Lython/Runtime/Text/PyStringOps.Whitespace.cs
@@ -10,4 +10,77 @@ internal static partial class PyStringOps
         >= 0x09 and <= 0x0D or >= 0x1C and <= 0x20 or
         0x85 or 0xA0 or 0x1680 or >= 0x2000 and <= 0x200A or
         0x2028 or 0x2029 or 0x202F or 0x205F or 0x3000;
+
+    // One boundary implementation for sizing and construction. Bulk operations
+    // stay bounded so long ASCII words cannot hide cancellation inside a CLR call.
+    private ref struct WhitespaceWordScanner
+    {
+        private const int ScanChunkBytes = 4096;
+        private readonly ReadOnlySpan<byte> _source;
+        private readonly LythonRuntime.ExecutionContext? _context;
+        private readonly LythonSourceSpan? _span;
+        private int _position;
+        private int _remaining;
+
+        public WhitespaceWordScanner(ReadOnlySpan<byte> source, int maxSplit,
+            LythonRuntime.ExecutionContext? context, LythonSourceSpan? span)
+        {
+            _source = source;
+            _context = context;
+            _span = span;
+            _position = 0;
+            _remaining = maxSplit;
+        }
+
+        public bool MoveNext(out int start, out int end)
+        {
+            _context?.CheckExecution(_span);
+            while (_position < _source.Length)
+            {
+                PyStructuralGuard.NoteWork(_context, _span);
+                if (_source[_position] is (byte)' ' or (byte)'\t')
+                {
+                    _context?.CheckExecution(_span);
+                    var chunk = _source.Slice(_position, Math.Min(ScanChunkBytes, _source.Length - _position));
+                    var other = chunk.IndexOfAnyExcept((byte)' ', (byte)'\t');
+                    _position += other < 0 ? chunk.Length : other;
+                    if (other < 0) continue;
+                }
+                Rune.DecodeFromUtf8(_source[_position..], out var rune, out var length);
+                if (!IsPythonWhitespace(rune)) break;
+                _position += length;
+            }
+            start = _position;
+            if (start == _source.Length)
+            {
+                end = start;
+                return false;
+            }
+            if (_remaining == 0)
+            {
+                end = _source.Length;
+                _position = end;
+                return true;
+            }
+
+            while (_position < _source.Length)
+            {
+                if (_source[_position] is >= 0x21 and <= 0x7F)
+                {
+                    _context?.CheckExecution(_span);
+                    var chunk = _source.Slice(_position, Math.Min(ScanChunkBytes, _source.Length - _position));
+                    var other = chunk.IndexOfAnyExceptInRange((byte)0x21, (byte)0x7F);
+                    _position += other < 0 ? chunk.Length : other;
+                    if (other < 0) continue;
+                }
+                PyStructuralGuard.NoteWork(_context, _span);
+                Rune.DecodeFromUtf8(_source[_position..], out var rune, out var length);
+                if (IsPythonWhitespace(rune)) break;
+                _position += length;
+            }
+            end = _position;
+            if (_remaining > 0) _remaining--;
+            return true;
+        }
+    }
 }
