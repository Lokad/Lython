@@ -0,0 +1,14 @@
+using Lokad.Lython.Frontend;
+
+namespace Lokad.Lython.Runtime;
+
+// Binding consumes borrowed operands synchronously into owned parameter storage.
+// The caller retains its operand storage until invocation and cleanup finish.
+internal interface IPyOperandCallable : LythonRuntime.ICallable
+{
+    object InvokeFromOperands(ReadOnlySpan<object?> arguments, LythonSourceSpan span,
+        LythonRuntime.ExecutionContext context, object? receiver = null, ExecutableCallSite? callSite = null);
+
+    ValueTask<object> InvokeFromOperandsAsync(ReadOnlySpan<object?> arguments, LythonSourceSpan span,
+        LythonRuntime.ExecutionContext context, object? receiver = null, ExecutableCallSite? callSite = null);
+}
