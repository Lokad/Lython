    "source": "using System.Runtime.CompilerServices;\nusing System.Text.Json;\nusing Lokad.Lython.Runtime;\nusing Lokad.Lython.Tests.Harness;\n\nnamespace Lokad.Lython.Tests;\n\npublic sealed class PartialExhaustionReliefOriginalTests\n{\n    [Fact]\n    public void AlreadyCollectedSubsetCanRelieveWithoutCollectingAllDroppedTargets()\n    {\n        var context = new LythonRuntime.ExecutionContext(new MockLythonHost(),\n            new LythonRunOptions { MaxExecutionMemoryBytes = 2000000 });\n        var governor = context.MemoryGovernor;\n        var pool = context.State.CallTemporaries;\n        var baseline = governor.CurrentCommittedBytes;\n        var keys = Track(pool, governor);\n        Drop(keys, 0, 100);\n        GC.Collect();\n        GC.WaitForPendingFinalizers();\n        GC.Collect();\n        Drop(keys, 100, 100);\n        using var hold = governor.ReserveTemporary(2000000 - governor.CurrentAccountedBytes - 15000, null);\n        var before = GC.CollectionCount(2);\n        governor.Reserve(25000, null);\n        var collections = GC.CollectionCount(2) - before;\n        var remaining = pool.Count;\n        var accounted = governor.CurrentAccountedBytes;\n        var directory = Environment.GetEnvironmentVariable(\"LYTHON_PRIMITIVE_PARTIAL_GC\")!;\n        File.WriteAllText(directory, JsonSerializer.Serialize(new { collections, remaining, accounted }));\n        Assert.Equal(0, collections);\n        Assert.Equal(100, remaining);\n        Assert.True(accounted <= 2000000);\n        Assert.Equal(baseline + pool.CommittedBackingBytes + remaining * 256L, governor.CurrentCommittedBytes);\n        GC.Collect();\n        GC.WaitForPendingFinalizers();\n        GC.Collect();\n        pool.Sweep(full: true);\n        Assert.Equal(0, pool.Count);\n        Assert.Equal(baseline + pool.CommittedBackingBytes, governor.CurrentCommittedBytes);\n        governor.ReleaseReserved(25000);\n        GC.KeepAlive(keys);\n    }\n\n    [MethodImpl(MethodImplOptions.NoInlining)]\n    private static List<object> Track(ChargeReclamationPool pool, MemoryGovernor governor)\n    {\n        var keys = new List<object>();\n        for (var i = 0; i < 200; i++)\n        {\n            var value = new object();\n            governor.Reserve(128, null);\n            governor.Commit(128);\n            pool.Track(value, 128);\n            keys.Add(value);\n        }\n        return keys;\n    }\n\n    [MethodImpl(MethodImplOptions.NoInlining)]\n    private static void Drop(List<object> keys, int start, int count)\n    {\n        for (var i = start; i < start + count; i++) keys[i] = null!;\n    }\n}",
