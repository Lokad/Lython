index 4831ae59..ae7f2901 100644
--- a/tests/Lokad.Lython.PublicApi.Tests/ArithmeticPrecedenceTests.cs
+++ b/tests/Lokad.Lython.PublicApi.Tests/ArithmeticPrecedenceTests.cs
@@ -4,6 +4,35 @@ namespace Lokad.Lython.PublicApi.Tests;
 
 public sealed class ArithmeticPrecedenceTests
 {
+    [Theory]
+    [InlineData(" + ", "1 * 2", "128")]
+    [InlineData(" | ", "1 & 3", "1")]
+    public async Task MixedFlatChainsKeepIndependentPrecedenceBounds(string separator, string operand, string expected)
+    {
+        var budget = new LythonMemoryBudget(4 * 1024 * 1024);
+        using (var script = new LythonEngine().Compile("print(" + string.Join(separator, Enumerable.Repeat(operand, 64)) + ")", budget))
+        {
+            Assert.True(script.IsValid, string.Join(" | ", script.Diagnostics.Select(d => d.Message)));
+            var baseline = budget.ReservedBytes;
+            foreach (var asynchronous in new[] { false, true })
+            {
+                using (var result = asynchronous ? await script.RunAsync(new MockLythonHost()) : script.Run(new MockLythonHost()))
+                {
+                    Assert.True(result.Success, result.Failure?.Message);
+                    Assert.Equal(expected + "\n", result.StandardOutput);
+                }
+                Assert.Equal(baseline, budget.ReservedBytes);
+            }
+        }
+        Assert.Equal(0, budget.ReservedBytes);
+        using (var script = new LythonEngine().Compile("print(" + string.Join(separator, Enumerable.Repeat(operand, 65)) + ")", budget))
+        {
+            Assert.False(script.IsValid);
+            Assert.Contains(script.Diagnostics, d => d.Code == "LA0003" && d.Message.Contains("Expression chain", StringComparison.Ordinal));
+        }
+        Assert.Equal(0, budget.ReservedBytes);
+    }
+
     [Theory]
     [InlineData("|", "LA1061", "Expected expression after bitwise '|'.")]
     [InlineData("^", "LA1062", "Expected expression after bitwise '^'.")]
