diff --git a/src/Lokad.Lython/Runtime/Calls/FunctionParameterLayout.cs b/src/Lokad.Lython/Runtime/Calls/FunctionParameterLayout.cs
new file mode 100644
--- /dev/null
+++ b/src/Lokad.Lython/Runtime/Calls/FunctionParameterLayout.cs
@@ -0,0 +1,62 @@
+using Lokad.Lython.Frontend;
+
+namespace Lokad.Lython.Runtime;
+
+// Immutable binding metadata. Ordinary def layouts belong to compiled storage;
+// dynamically generated signatures admit this storage when their plan is built.
+internal sealed class FunctionParameterLayout
+{
+    internal FunctionParameterLayout(IReadOnlyList<LoweredFunctionParameter> parameters)
+    {
+        var positionalCount = 0;
+        var keywordCount = 0;
+        foreach (var parameter in parameters)
+        {
+            switch (parameter.Kind)
+            {
+                case FunctionParameterKind.PositionalOnly:
+                    PositionalOnlyCount++;
+                    positionalCount++;
+                    break;
+                case FunctionParameterKind.Positional: positionalCount++; break;
+                case FunctionParameterKind.KeywordOnly: keywordCount++; break;
+                case FunctionParameterKind.VariadicList: VariadicList = parameter; break;
+                case FunctionParameterKind.VariadicDictionary: VariadicDictionary = parameter; break;
+            }
+        }
+        var positional = new LoweredFunctionParameter[positionalCount];
+        var keywordOnly = new LoweredFunctionParameter[keywordCount];
+        var p = 0;
+        var k = 0;
+        foreach (var parameter in parameters)
+        {
+            if (parameter.Kind is FunctionParameterKind.PositionalOnly or FunctionParameterKind.Positional)
+                positional[p++] = parameter;
+            else if (parameter.Kind == FunctionParameterKind.KeywordOnly)
+                keywordOnly[k++] = parameter;
+        }
+        PositionalParameters = positional;
+        KeywordOnlyParameters = keywordOnly;
+        NamedLayoutCount = positionalCount + keywordCount;
+        var names = new string[NamedLayoutCount + (VariadicList is null ? 0 : 1) + (VariadicDictionary is null ? 0 : 1)];
+        var indexes = new Dictionary<string, int>(names.Length, StringComparer.Ordinal);
+        var index = 0;
+        foreach (var parameter in positional) Add(parameter.Name);
+        foreach (var parameter in keywordOnly) Add(parameter.Name);
+        if (VariadicList is not null) Add(VariadicList.Name);
+        if (VariadicDictionary is not null) Add(VariadicDictionary.Name);
+        LayoutParameterNames = names;
+        LayoutParameterIndex = indexes;
+
+        void Add(string name) { indexes[name] = index; names[index++] = name; }
+    }
+
+    internal IReadOnlyList<LoweredFunctionParameter> PositionalParameters { get; }
+    internal IReadOnlyList<LoweredFunctionParameter> KeywordOnlyParameters { get; }
+    internal IReadOnlyList<string> LayoutParameterNames { get; }
+    internal IReadOnlyDictionary<string, int> LayoutParameterIndex { get; }
+    internal int NamedLayoutCount { get; }
+    internal int PositionalOnlyCount { get; }
+    internal LoweredFunctionParameter? VariadicList { get; }
+    internal LoweredFunctionParameter? VariadicDictionary { get; }
+}
