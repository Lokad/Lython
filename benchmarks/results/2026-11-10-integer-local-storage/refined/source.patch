diff --git a/src/Lokad.Lython/Runtime/LythonRuntime.Executable.IntegerLocals.cs b/src/Lokad.Lython/Runtime/LythonRuntime.Executable.IntegerLocals.cs
new file mode 100644
index 00000000..fef59eeb
--- /dev/null
+++ b/src/Lokad.Lython/Runtime/LythonRuntime.Executable.IntegerLocals.cs
@@ -0,0 +1,179 @@
+using System.Numerics;
+using System.Runtime.CompilerServices;
+using Lokad.Lython.Frontend;
+
+namespace Lokad.Lython.Runtime;
+
+internal sealed partial class LythonRuntime
+{
+    // A deferred value in an existing local slot, never a guest-visible object.
+    // Reads replace it once with the ordinary immutable BigInteger box. Copies
+    // then share that box; later arithmetic cannot change a retained alias.
+    private static readonly object NativeIntegerLocal = new();
+
+    internal static BinaryOperatorSyntax? NativeIntegerOperation(in ExecutableInstruction instruction)
+    {
+        var operation = instruction.OpCode switch
+        {
+            ExecutableOpCode.Binary => instruction.BinaryOperator,
+            ExecutableOpCode.Augmented => instruction.AugmentedOperator switch
+            {
+                AugmentedAssignmentOperatorSyntax.Add => BinaryOperatorSyntax.Add,
+                AugmentedAssignmentOperatorSyntax.Subtract => BinaryOperatorSyntax.Subtract,
+                AugmentedAssignmentOperatorSyntax.Multiply => BinaryOperatorSyntax.Multiply,
+                AugmentedAssignmentOperatorSyntax.BitwiseAnd => BinaryOperatorSyntax.BitwiseAnd,
+                AugmentedAssignmentOperatorSyntax.BitwiseOr => BinaryOperatorSyntax.BitwiseOr,
+                AugmentedAssignmentOperatorSyntax.BitwiseXor => BinaryOperatorSyntax.BitwiseXor,
+                AugmentedAssignmentOperatorSyntax.LeftShift => BinaryOperatorSyntax.LeftShift,
+                AugmentedAssignmentOperatorSyntax.RightShift => BinaryOperatorSyntax.RightShift,
+                _ => BinaryOperatorSyntax.Or,
+            },
+            _ => BinaryOperatorSyntax.Or,
+        };
+        return operation is BinaryOperatorSyntax.Add or BinaryOperatorSyntax.Subtract or BinaryOperatorSyntax.Multiply
+            or BinaryOperatorSyntax.BitwiseAnd or BinaryOperatorSyntax.BitwiseOr or BinaryOperatorSyntax.BitwiseXor
+            or BinaryOperatorSyntax.LeftShift or BinaryOperatorSyntax.RightShift ? operation : null;
+    }
+
+    internal partial struct ExecutableValueStorage
+    {
+        internal bool HasNativeIntegerLocals => _integerLocals is not null;
+
+        internal object? ReadLocalValue(int slot)
+        {
+            var value = _items[slot];
+            return ReferenceEquals(value, NativeIntegerLocal) ? MaterializeNativeIntegerLocal(slot) : value;
+        }
+
+        // Keep the ordinary object read small even when its caller is inlined
+        // into the instruction loop. Only an observed deferred integer boxes.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private object MaterializeNativeIntegerLocal(int slot)
+        {
+            object boxed = new BigInteger(_integerLocals![slot]);
+            _items[slot] = boxed;
+            return boxed;
+        }
+
+        internal bool TryReadNativeIntegerLocal(int slot, out long value)
+        {
+            if (ReferenceEquals(_items[slot], NativeIntegerLocal))
+            {
+                value = _integerLocals![slot];
+                return true;
+            }
+            value = 0;
+            return false;
+        }
+
+        internal void StoreNativeIntegerLocal(int slot, long value)
+        {
+            _integerLocals![slot] = value;
+            _items[slot] = NativeIntegerLocal;
+        }
+    }
+
+    internal sealed partial class ExecutionContext
+    {
+        private static bool TryReadNativeIntegerInput(ref ExecutableWorkState execution, int source, out long value)
+        {
+            object? input;
+            if (source < 0) input = execution.Code.Constants[~source];
+            else
+            {
+                if (source >= execution.Code.FirstTemporarySlot) { value = 0; return false; }
+                if (execution.Stack.TryReadNativeIntegerLocal(source, out value)) return true;
+                input = execution.Locals[source];
+            }
+            if (input is BigInteger integer && integer.GetByteCount() <= sizeof(long))
+            {
+                value = (long)integer;
+                return true;
+            }
+            value = 0;
+            return false;
+        }
+
+        private static bool TryExecuteNativeIntegerLocal(ref ExecutableWorkState execution, ExecutionContext? invocation,
+            in ExecutableInstruction instruction)
+        {
+            if (!instruction.HasLocalResult || !execution.Stack.HasNativeIntegerLocals
+                || invocation?.MirrorLocalStores == true || invocation?.GlobalNamespace is not null)
+                return false;
+            var operation = NativeIntegerOperation(instruction);
+            if (operation is null) return false;
+            ref readonly var store = ref execution.Code.Instructions[execution.InstructionIndex + 1];
+            if (!execution.Code.NativeIntegerLocals[store.LocalSlot]
+                || !TryReadNativeIntegerInput(ref execution, instruction.InputStart, out var left)
+                || !TryReadNativeIntegerInput(ref execution, instruction.SecondInput, out var right)
+                || !TryComputeNativeInteger(operation.Value, left, right, out var result)) return false;
+
+            // Pure eligibility/arithmetic above has neither admitted storage nor
+            // invoked Python. Oversized results take the existing exact-number
+            // operation and preflight before any actual integer allocation.
+            if (instruction.LiveExtent < execution.Stack.LiveExtent) execution.Stack.RetireTo(instruction.LiveExtent);
+            if (execution.Stack.HasPendingDisposals)
+            {
+                execution.Stack.PublishValue(instruction.ResultSlot, instruction.LiveExtent, new BigInteger(result));
+                return true;
+            }
+            execution.Stack.ForgetResultInput(instruction.ResultSlot);
+            execution.Stack.CheckExecution(store.Span);
+            // Retirement can run native cleanup. If that exposed the namespace,
+            // obey the same store policy as every ordinary local assignment.
+            if (invocation?.MirrorLocalStores == true || invocation?.GlobalNamespace is not null)
+                StoreLocalValue(execution.Code, execution.Locals, execution.LocalCells, invocation,
+                    store.LocalSlot, new BigInteger(result), store.Span);
+            else execution.Stack.StoreNativeIntegerLocal(store.LocalSlot, result);
+            execution.InstructionIndex++;
+            return true;
+        }
+
+        private static bool TryComputeNativeInteger(BinaryOperatorSyntax operation, long left, long right, out long result)
+        {
+            unchecked
+            {
+                switch (operation)
+                {
+                    case BinaryOperatorSyntax.Add:
+                        result = left + right;
+                        return ((left ^ result) & (right ^ result)) >= 0;
+                    case BinaryOperatorSyntax.Subtract:
+                        result = left - right;
+                        return ((left ^ right) & (left ^ result)) >= 0;
+                    case BinaryOperatorSyntax.BitwiseAnd: result = left & right; return true;
+                    case BinaryOperatorSyntax.BitwiseOr: result = left | right; return true;
+                    case BinaryOperatorSyntax.BitwiseXor: result = left ^ right; return true;
+                    case BinaryOperatorSyntax.RightShift when right >= 0:
+                        result = right < 64 ? left >> (int)right : left < 0 ? -1 : 0;
+                        return true;
+                }
+                Int128 wide;
+                if (operation == BinaryOperatorSyntax.Multiply) wide = (Int128)left * right;
+                else if (operation == BinaryOperatorSyntax.LeftShift && right is >= 0 and < 64) wide = (Int128)left << (int)right;
+                else { result = 0; return operation == BinaryOperatorSyntax.LeftShift && right >= 64 && left == 0; }
+                if (wide < long.MinValue || wide > long.MaxValue) { result = 0; return false; }
+                result = (long)wide;
+                return true;
+            }
+        }
+
+        private static bool TryCompareNativeIntegers(ref ExecutableWorkState execution, in ExecutableInstruction instruction, out bool truth)
+        {
+            truth = false;
+            if (!execution.Stack.HasNativeIntegerLocals
+                || !TryReadNativeIntegerInput(ref execution, instruction.InputStart, out var left)
+                || !TryReadNativeIntegerInput(ref execution, instruction.SecondInput, out var right)) return false;
+            switch (instruction.BinaryOperator)
+            {
+                case BinaryOperatorSyntax.Equal: truth = left == right; return true;
+                case BinaryOperatorSyntax.NotEqual: truth = left != right; return true;
+                case BinaryOperatorSyntax.Less: truth = left < right; return true;
+                case BinaryOperatorSyntax.LessEqual: truth = left <= right; return true;
+                case BinaryOperatorSyntax.Greater: truth = left > right; return true;
+                case BinaryOperatorSyntax.GreaterEqual: truth = left >= right; return true;
+                default: return false;
+            }
+        }
+    }
+}
