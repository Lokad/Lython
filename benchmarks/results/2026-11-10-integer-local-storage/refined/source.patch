@@ -0,0 +1,28 @@
+using Lokad.Lython.Runtime;
+
+namespace Lokad.Lython.Frontend;
+
+internal sealed partial class ExecutableCodeObject
+{
+    // Only final local stores can defer boxing. Captures and mirrored namespaces
+    // retain ordinary object storage; dynamic values still use normal operations.
+    private bool[] PrepareNativeIntegerLocals()
+    {
+        if (RequiresLocalVariableMirroring) return [];
+        bool[]? slots = null;
+        for (var index = 0; index + 1 < Instructions.Length; index++)
+        {
+            ref readonly var instruction = ref Instructions[index];
+            if (!instruction.HasLocalResult || LythonRuntime.NativeIntegerOperation(instruction) is null
+                || instruction.InputStart >= FirstTemporarySlot || instruction.SecondInput >= FirstTemporarySlot)
+                continue;
+            ref readonly var store = ref Instructions[index + 1];
+            if (store.OpCode != ExecutableOpCode.StoreLocal || LocalNames[store.LocalSlot].StartsWith('<')) continue;
+            slots ??= new bool[LocalNames.Count];
+            slots[store.LocalSlot] = true;
+        }
+        if (slots is null) return [];
+        foreach (var captured in CapturedLocalSlots) slots[captured] = false;
+        return slots.Any(static slot => slot) ? slots : [];
+    }
+}
