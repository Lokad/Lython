diff --git a/src/Lokad.Lython/Runtime/LythonRuntime.Executable.Interpreter.Invocation.cs b/src/Lokad.Lython/Runtime/LythonRuntime.Executable.Interpreter.Invocation.cs
new file mode 100644
index 00000000..6a2cb27d
--- /dev/null
+++ b/src/Lokad.Lython/Runtime/LythonRuntime.Executable.Interpreter.Invocation.cs
@@ -0,0 +1,69 @@
+using Lokad.Lython.Frontend;
+
+namespace Lokad.Lython.Runtime;
+
+internal sealed partial class LythonRuntime
+{
+    internal sealed partial class ExecutionContext
+    {
+        // Completed branch decisions stay synchronous. Only asynchronous work
+        // uses pending; the prefix joins it through its existing pause boundary.
+        // Native operations still execute before requesting this context.
+        private bool ExecuteInvocationInstruction(in ExecutableInstruction instruction, bool asynchronous,
+            out ValueTask<bool> pending)
+        {
+            pending = default;
+            ValueTask operation;
+            switch (instruction.OpCode)
+            {
+                case ExecutableOpCode.StoreMember or ExecutableOpCode.StoreMemberLast
+                    or ExecutableOpCode.StoreSlice or ExecutableOpCode.StoreSliceLast
+                    or ExecutableOpCode.ReadRetainedSubscript or ExecutableOpCode.ReadRetainedSlice
+                    or ExecutableOpCode.UnpackValues or ExecutableOpCode.FailAssertion or ExecutableOpCode.Raise
+                    or ExecutableOpCode.DeleteName or ExecutableOpCode.DeleteMember
+                    or ExecutableOpCode.DeleteSubscript or ExecutableOpCode.DeleteSlice:
+                    operation = ExecuteTargetInstruction(instruction, asynchronous);
+                    break;
+                case ExecutableOpCode.ApplyOperation:
+                    operation = ExecutePreparedOperationAsync(instruction, asynchronous);
+                    break;
+                case ExecutableOpCode.StartFormattedString or ExecutableOpCode.AppendFormattedText
+                    or ExecutableOpCode.FinishFormattedString or ExecutableOpCode.ConvertFormattedValue or ExecutableOpCode.FormatField:
+                    operation = ExecuteFormattedValueAsync(instruction, asynchronous);
+                    break;
+                case ExecutableOpCode.Import or ExecutableOpCode.DefineFunction or ExecutableOpCode.ExecuteFallbackStatement:
+                    if (!asynchronous)
+                    {
+                        ExecuteDefinitionOrFallback(instruction);
+                        return false;
+                    }
+                    operation = ExecuteDefinitionOrFallbackAsync(instruction);
+                    break;
+                case ExecutableOpCode.MakeSet or ExecutableOpCode.MakeDict or ExecutableOpCode.MatchCase:
+                    return ExecuteStructure(instruction);
+                case ExecutableOpCode.ResolveContextManager or ExecutableOpCode.EnterContextManager or ExecutableOpCode.ExitContextManager:
+                    if (!asynchronous) return ExecuteStructure(instruction);
+                    pending = ExecuteContextManagerAsync(instruction);
+                    return false;
+                case ExecutableOpCode.ForNext:
+                    if (!asynchronous) return ExecuteForNext(instruction);
+                    pending = ExecuteForNextAsync(instruction);
+                    return false;
+                case ExecutableOpCode.GetIter or ExecutableOpCode.Slice or ExecutableOpCode.MakeSlice:
+                    if (!asynchronous || instruction.OpCode == ExecutableOpCode.MakeSlice)
+                    {
+                        ExecuteValueOperation(instruction);
+                        return false;
+                    }
+                    operation = instruction.OpCode == ExecutableOpCode.GetIter
+                        ? ExecuteGetIteratorAsync(instruction) : ExecuteSliceValueOperationAsync(instruction);
+                    break;
+                default:
+                    throw new InvalidOperationException($"Unexpected invocation instruction: {instruction.OpCode}");
+            }
+            if (asynchronous) pending = WithoutJump(operation);
+            else operation.GetAwaiter().GetResult();
+            return false;
+        }
+    }
+}
