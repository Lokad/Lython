-{
-    Read,
-    Binary, Augmented,
-    Subscript,
-    BuiltinUnary,
-    StringMethod, BytesMethod, BooleanMethod, ListMethod,
-    Split, Replace, StartsWith, EndsWith,
-    CasedSplit,
-    ConvertFormat, FormatValue,
-    Conditional, None, EmptySequence, StoreClosure,
-}
