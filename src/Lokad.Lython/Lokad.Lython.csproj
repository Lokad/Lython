<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Lokad.Lython</PackageId>
    <Title>Lokad.Lython</Title>
    <Description>Embeddable, contained-by-design Python runtime for .NET, implemented in managed C# with host-mediated file and process capabilities.</Description>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Version>0.10.0</Version>
    <AssemblyVersion>0.10.0</AssemblyVersion>
    <FileVersion>0.10.0</FileVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>0.10.0 adds governed sequential binary file handles and shared writer publication; governed Path byte reads/writes through optional host capabilities; governed structured URL components/reassembly, bounded per-execution split caching, tuple results, quoting and query parsing; faithful final-sigma casing and denied casing cleanup, type-slot sequence iteration and async iterator binding; governed shared ASCII and Windows-1252 codecs and reader-construction cleanup; governed HTML escaping and HTML5 entity decoding; bounded textwrap.dedent/indent and Python 3.13 whitespace, line boundaries and Unicode repr/printability; governed io.StringIO and io.BytesIO, JSON and CSV text-stream protocols, decoder/encoder instances, incremental encoding, guest subclasses and selected-class dispatch; awaits JSON hooks, stream callbacks and host effects consistently; bounds prefix-decoding scratch and preserves mutable encoder options; fixes Python operator/decorator/indexing semantics, callable/membership/truth type slots, positional keyword collisions, class lambda binding and composed comprehension/call/f-string syntax; preserves optional XLSX XML attributes and CSV iterator identity; corrects binding-aware dataclass and guarded dictionary diagnostics and os.walk slice assignments; encodes Counter/defaultdict mappings; supports regex match subscripts and safe group selectors; and verifies the supported grammar and mediated file publication through the exact Release package.</PackageReleaseNotes>
    <PackageTags>python;runtime;interpreter;scripting;embedding;sandbox</PackageTags>
    <PackageProjectUrl>https://github.com/Lokad/Lython</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Lokad/Lython.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>..\..\artifacts\nuget\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Runtime\Text\Data\html5.json" LogicalName="Lokad.Lython.html5.json" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\third_party\Python.LICENSE.txt" Pack="true" PackagePath="third_party\" Visible="false" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\SUPPORTED_SYNTAX.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\SPEC.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- AllowUnsafeBlocks covers only ExecutionBudgetGuards.StackRuler, which reads
       the current stack address (never dereferenced) because safe C# exposes no
       stack telemetry for the MG25 recursion backstop. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lokad.Parsing" />
    <PackageReference Include="Lokad.Utf8Regex.PythonRe" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="EnforceReleasePackageConfiguration" BeforeTargets="GenerateNuspec"
          Condition="'$(Configuration)' != 'Release' and '$(AllowNonReleasePackage)' != 'true'">
    <Error Text="NuGet packages must be produced with -c Release. Pass /p:AllowNonReleasePackage=true only for troubleshooting." />
  </Target>
</Project>
