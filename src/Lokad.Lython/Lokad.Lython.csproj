<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Lokad.Lython</PackageId>
    <Title>Lokad.Lython</Title>
    <Description>Embeddable, contained-by-design Python runtime for .NET, implemented in managed C# with host-mediated file and process capabilities.</Description>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Version>0.11.0</Version>
    <AssemblyVersion>0.11.0</AssemblyVersion>
    <FileVersion>0.11.0</FileVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Adds .NET 11 alongside .NET 10, explicit executable call activations, prepared lexical scope facts, lazy str.format_map lookup and user-class subscription. Corrects class annotation namespaces, comprehension scope and empty gzip/ZIP output. Preserves cooperative memory ownership, host cancellation and core regex-provider decoupling. See CHANGELOG.md and the current guides under docs/; testing guidance is under tests/README.md.</PackageReleaseNotes>
    <PackageTags>python;runtime;interpreter;scripting;embedding;sandbox</PackageTags>
    <PackageProjectUrl>https://github.com/Lokad/Lython</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Lokad/Lython.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lokad.Lython.WhiteBox.Tests" />
    <AssemblyMetadata Include="BuildSdkVersion" Value="$(NETCoreSdkVersion)" />
    <EmbeddedResource Include="Runtime\Text\Data\html5.json" LogicalName="Lokad.Lython.html5.json" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\tests\README.md" Pack="true" PackagePath="tests/" Visible="false" />
    <None Include="..\..\docs\*.md" Pack="true" PackagePath="docs/" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lokad.Parsing" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="PreparePackageReadme" BeforeTargets="_GetPackageFiles" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_ReadmeCommit Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</_ReadmeCommit>
      <_ReadmeCommit Condition="'$(_ReadmeCommit)' == ''">$(RepositoryCommit)</_ReadmeCommit>
      <_PackageReadmePath>$(IntermediateOutputPath)nuget/README.md</_PackageReadmePath>
      <_SourceReadme>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../README.md'))</_SourceReadme>
      <_PackageReadme>$([System.Text.RegularExpressions.Regex]::Replace('$(_SourceReadme)', '\]\((?!https?://|#)([^)]+)\)', ']($(PackageProjectUrl)/blob/$(_ReadmeCommit)/$1)'))</_PackageReadme>
    </PropertyGroup>
    <Error Condition="'$(_ReadmeCommit)' == ''" Text="Package documentation requires a source revision; supply RepositoryCommit when packing a source archive." />
    <MakeDir Directories="$(IntermediateOutputPath)nuget" />
    <WriteLinesToFile File="$(_PackageReadmePath)" Lines="$([MSBuild]::Escape('$(_PackageReadme)'))" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup><None Include="$(_PackageReadmePath)" Pack="true" PackagePath="README.md" /></ItemGroup>
  </Target>

</Project>
